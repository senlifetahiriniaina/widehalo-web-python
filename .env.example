DJANGO_SETTINGS_MODULE=config.settings.dev
# En production, generer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Alphabet URL-safe base64 ([A-Za-z0-9_-]) — jamais de `$`, contrairement a
# un generateur de mot de passe generique avec symboles : un `$` dans cette
# valeur serait interprete a tort par Docker Compose comme le debut d'une
# reference `${VAR}` lors de la lecture de .env, tronquant silencieusement
# le secret reellement injecte dans les conteneurs (cf. docs/
# DEPLOYMENT_HETZNER.md, section 11, "variable is not set").
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Variables ci-dessous utilisees uniquement en production (docker-compose.prod.yml,
# cf. docs/DEPLOYMENT_HETZNER.md) — sans effet en dev, laisser telles quelles.
# Sous-domaine reel pointe vers l'IP du VM Hetzner (enregistrement DNS de type A) ;
# Caddy (service `caddy` de docker-compose.prod.yml) demande/renouvelle
# automatiquement un certificat Let's Encrypt pour ce nom, jamais pour l'IP nue.
WIDEHALO_DOMAIN=app.widehalo.cloud
# E-mail transmis a Let's Encrypt (expiration/urgence uniquement, pas de trafic).
ACME_EMAIL=admin@example.com
# En production : DJANGO_ALLOWED_HOSTS=app.widehalo.cloud (le nom seul, sans schema).
# CSRF_TRUSTED_ORIGINS exige un schema explicite (distinct de ALLOWED_HOSTS) :
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.widehalo.cloud

POSTGRES_DB=widehalo
# Identifiants du role APPLICATIF Django — cree (jamais superuser) par
# docker/init-db/001-init-app-role.sh, distinct du role bootstrap ci-dessous.
POSTGRES_USER=widehalo_app
POSTGRES_PASSWORD=widehalo_app
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Identite BOOTSTRAP du cluster Postgres (role initdb, jamais utilisee par
# Django ni par aucun code applicatif) — a changer en production pour un mot
# de passe fort et distinct de POSTGRES_PASSWORD ci-dessus (cf.
# docker/init-db/001-init-app-role.sh pour l'explication complete : ce role
# ne peut structurellement jamais perdre son privilege superuser).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-in-production

REDIS_URL=redis://redis:6379/0

CLAMAV_ENABLED=false

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# E-mail sortant en production (cf. config/settings/prod.py) — Gmail SMTP
# par defaut (smtp.gmail.com:587, STARTTLS), aucun serveur dedie necessaire
# pour ce lot. EMAIL_HOST_USER = adresse Gmail expeditrice ; EMAIL_HOST_PASSWORD
# = un mot de passe d'application Gmail (compte Google -> Securite -> Mots de
# passe des applications, exige la validation en 2 etapes active), JAMAIS le
# mot de passe du compte. Sans effet en dev (EMAIL_BACKEND=console) ni en test.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-application-gmail
DEFAULT_FROM_EMAIL=votre-adresse@gmail.com
