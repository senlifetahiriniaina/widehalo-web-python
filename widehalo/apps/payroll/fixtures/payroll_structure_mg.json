{
  "structure": {
    "code": "MG_BASE",
    "name": "Structure de reference Madagascar",
    "country": "MG"
  },
  "rules": [
    {"sequence": 10, "code": "SAL_BASE", "name": "Salaire de base (prorata)", "category": "base",
     "amount_type": "python",
     "amount": "contract['wage_base'] * (worked_days / contract['reference_days'])"},
    {"sequence": 20, "code": "PRIME_TOTAL", "name": "Primes et avantages", "category": "base",
     "amount_type": "python", "amount": "sum_amounts(benefits, 'amount')"},
    {"sequence": 30, "code": "HEURES_SUP", "name": "Heures supplementaires majorees", "category": "base",
     "amount_type": "python",
     "amount": "overtime_total_pay(contract['hourly_rate'], overtime, params['overtime_multipliers'])"},
    {"sequence": 40, "code": "BRUT", "name": "Salaire brut", "category": "brut",
     "amount_type": "python",
     "amount": "result_rules['SAL_BASE'] + result_rules['PRIME_TOTAL'] + result_rules['HEURES_SUP']"},
    {"sequence": 50, "code": "BASE_COTISABLE", "name": "Base cotisable (plafonnee 8xSME)", "category": "base",
     "amount_type": "python", "amount": "min(result_rules['BRUT'], params['social_ceiling'])",
     "base_code": "BRUT"},
    {"sequence": 60, "code": "CNAPS_SAL", "name": "CNaPS salariale", "category": "cotisation_salariale",
     "amount_type": "python",
     "amount": "result_rules['BASE_COTISABLE'] * params['cnaps_employee_rate']",
     "base_code": "BASE_COTISABLE"},
    {"sequence": 70, "code": "OSTIE_SAL", "name": "OSTIE salariale", "category": "cotisation_salariale",
     "amount_type": "python",
     "amount": "result_rules['BASE_COTISABLE'] * params['ostie_employee_rate']",
     "base_code": "BASE_COTISABLE"},
    {"sequence": 80, "code": "CNAPS_PAT", "name": "CNaPS patronale", "category": "cotisation_patronale",
     "amount_type": "python",
     "amount": "result_rules['BASE_COTISABLE'] * params['cnaps_employer_rate']",
     "base_code": "BASE_COTISABLE"},
    {"sequence": 90, "code": "OSTIE_PAT", "name": "OSTIE patronale", "category": "cotisation_patronale",
     "amount_type": "python",
     "amount": "result_rules['BASE_COTISABLE'] * params['ostie_employer_rate']",
     "base_code": "BASE_COTISABLE"},
    {"sequence": 95, "code": "FMFP_PAT", "name": "FMFP patronale", "category": "cotisation_patronale",
     "amount_type": "python",
     "amount": "result_rules['BASE_COTISABLE'] * params['fmfp_employer_rate']",
     "base_code": "BASE_COTISABLE"},
    {"sequence": 100, "code": "OT_EXEMPT", "name": "Heures sup. exonerees IRSA (interne)", "category": "base",
     "amount_type": "python", "appears_on_payslip": false,
     "amount": "overtime_exempt_pay(contract['hourly_rate'], overtime, params['overtime_exempt_hours'], params['overtime_multipliers'])"},
    {"sequence": 110, "code": "BASE_IMPOSABLE", "name": "Base imposable IRSA", "category": "base",
     "amount_type": "python",
     "amount": "floor100(result_rules['BRUT'] - result_rules['CNAPS_SAL'] - result_rules['OSTIE_SAL'] - result_rules['OT_EXEMPT'])"},
    {"sequence": 120, "code": "IRSA_BRUT", "name": "IRSA par tranche (avec minimum de perception)",
     "category": "impot", "amount_type": "python",
     "amount": "irsa_tranche(result_rules['BASE_IMPOSABLE'], params['irsa_brackets'], params['irsa_minimum'])",
     "base_code": "BASE_IMPOSABLE"},
    {"sequence": 130, "code": "IRSA_REDUC", "name": "Reduction pour personne a charge", "category": "retenue",
     "amount_type": "python",
     "amount": "-min(params['irsa_dependent_reduction'] * employee['dependents'], result_rules['IRSA_BRUT'])"},
    {"sequence": 140, "code": "IRSA_NET", "name": "IRSA net", "category": "impot",
     "amount_type": "python", "amount": "result_rules['IRSA_BRUT'] + result_rules['IRSA_REDUC']"},
    {"sequence": 150, "code": "NET_IMPOSABLE", "name": "Net imposable", "category": "net_imposable",
     "amount_type": "python",
     "amount": "result_rules['BASE_IMPOSABLE'] - result_rules['IRSA_NET']"},
    {"sequence": 160, "code": "RETENUE_ABSENCE", "name": "Retenue absences non/partiellement payees",
     "category": "retenue", "amount_type": "python",
     "amount": "absence_deduction(contract['wage_base'] / contract['reference_days'], absences)"},
    {"sequence": 170, "code": "RETENUE_AVANCE", "name": "Retenue avance/pret", "category": "retenue",
     "amount_type": "python", "amount": "payslip['advance_deduction']"},
    {"sequence": 180, "code": "NET_A_PAYER", "name": "Net a payer", "category": "net_a_payer",
     "amount_type": "python",
     "amount": "result_rules['BRUT'] - result_rules['CNAPS_SAL'] - result_rules['OSTIE_SAL'] - result_rules['IRSA_NET'] - result_rules['RETENUE_ABSENCE'] - result_rules['RETENUE_AVANCE']"}
  ]
}
